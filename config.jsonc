{
  "modules-left": [
    "custom/trayicon",
    "tray",
    "custom/tasks",
    "workspaces"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "pulseaudio",
    "backlight",
    "battery",
    "clock"
  ],
  "custom/trayicon": {
    "format": ""
  },
  "tray": {
    "icon-size": 14,
    "spacing": 8
  },
  "custom/tasks": {
    "interval": 300,
    "exec": "~/.config/waybar/scripts/tasks | jq -r '.text | gsub(\"<[^>]*>\"; \"\")'",
    "on-click": "footclient --app-id taskterm sh -c 'task next; exec \"$SHELL\"'"
  },
  "workspaces": {
    "hide-empty": true,
    "on-click": "activate"
  },
  "cpu": {
    "format": " {usage}%   {frequency}GHz {temperature}",
    "on-click": "footclient btop"
  },
  "memory": {
    "format": " {used}GiB  󰾵 {swapUsed}GiB",
    "on-click": "footclient btop",
    "interval": 1
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "󰖁",
    "icons": [
      "",
      "",
      ""
    ],
    "on-scroll-up": "~/.local/bin/audio-control up",
    "on-scroll-down": "~/.local/bin/audio-control down",
    "on-click": "~/.local/bin/audio-control mute"
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "icons": [
      "󱩎",
      "󱩑",
      "󱩓",
      "󱩕",
      "󰛨"
    ]
  },
  "battery": {
    "format": " {power}W  {icon} {percent}%",
    "icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "icon-charging": "",
    "icon-full": "",
    "icon-ac": "",
    "on-click": "footclient btop"
  },
  "clock": {
    "format": "%a, %m-%d %I:%M %p"
  }
}
